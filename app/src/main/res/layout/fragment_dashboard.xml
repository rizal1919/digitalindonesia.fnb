<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_gradient"> <!-- Gradient Biru ke Putih -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="90dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- HEADER MODERN -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp">

                <!-- HAMBURGER -->
                <ImageView
                    android:id="@+id/btnMenu"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="8dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_menu_hamburger"
                    app:tint="#1E293B"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@id/btnMenu"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hi, Rizal!"
                        android:textStyle="bold"
                        android:textSize="22sp"
                        android:textColor="#1E293B"/>

                    <TextView
                        android:id="@+id/tvUserName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Owner • Edelweiss Cafe"
                        android:textSize="14sp"
                        android:textColor="#64748B"/>
                </LinearLayout>

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true">
                    <!-- notifikasi tetap sama -->
                </FrameLayout>
            </RelativeLayout>

            <!-- CARD LAPORAN PENJUALAN & PROFIT -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_modern_pattern"
                android:padding="20dp"
                android:layout_marginTop="16dp"
                android:elevation="8dp">

                <!-- Icon Mata di pojok kanan atas -->
                <ImageView
                    android:id="@+id/btnToggleEye"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentTop="true"
                    android:src="@drawable/ic_eye"
                    app:tint="#B3FFFFFF"
                    android:clickable="true"
                    android:focusable="true"/>

                <LinearLayout
                    android:id="@+id/layData"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp"
                    android:baselineAligned="false">

                    <!-- Kolom Penjualan -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Penjualan Hari Ini"
                            android:textColor="#CCD3FF"
                            android:textSize="12sp"/>
                        <TextView
                            android:id="@+id/tvTotalSales"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rp16.567.000"
                            android:textColor="@android:color/white"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>

                    <!-- Kolom Profit (Beda Warna) -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Estimasi Profit"
                            android:textColor="#B7FFCB"
                            android:textSize="12sp"/>
                        <TextView
                            android:id="@+id/tvTotalProfit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rp4.200.000"
                            android:textColor="#4CAF50"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Tombol Action -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_below="@id/layData"
                    android:layout_marginTop="20dp">

                    <TextView
                        android:id="@+id/btnDetail"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Lihat Detail"
                        android:textColor="@android:color/white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_pill_dark"
                        android:layout_marginEnd="8dp"/>

                    <TextView
                        android:id="@+id/btnExport"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Export Laporan"
                        android:textColor="@color/navy_end"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_pill_white"
                        android:layout_marginStart="8dp"/>
                </LinearLayout>
            </RelativeLayout>

            <!-- 4 KOTAK MENU -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="2"
                android:layout_marginTop="20dp"
                android:useDefaultMargins="false">

                <!-- Gunakan drawable corak/pattern baru di background -->
                <LinearLayout
                    android:id="@+id/menuProduk"
                    android:layout_width="0dp"
                    android:layout_height="130dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    android:orientation="vertical"
                    android:background="@drawable/bg_box_red"
                    android:padding="16dp"
                    android:gravity="bottom"
                    android:elevation="4dp">
                    <!-- Isian sama seperti sebelumnya -->
                    <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_produk" app:tint="@android:color/white" android:layout_marginBottom="12dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Produk" android:textColor="@android:color/white" android:textStyle="bold" android:textSize="16sp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/menuRiwayat"
                    android:layout_width="0dp"
                    android:layout_height="130dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    android:orientation="vertical"
                    android:background="@drawable/bg_box_orange"
                    android:padding="16dp"
                    android:gravity="bottom"
                    android:elevation="4dp">
                    <!-- Isian sama -->
                    <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_riwayat" app:tint="@android:color/white" android:layout_marginBottom="12dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Riwayat" android:textColor="@android:color/white" android:textStyle="bold" android:textSize="16sp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/menuStok"
                    android:layout_width="0dp"
                    android:layout_height="130dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    android:orientation="vertical"
                    android:background="@drawable/bg_box_bluelight"
                    android:padding="16dp"
                    android:gravity="bottom"
                    android:elevation="4dp">
                    <!-- Isian sama -->
                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_stok" app:tint="@android:color/white" android:layout_marginBottom="12dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Stok" android:textColor="@android:color/white" android:textStyle="bold" android:textSize="16sp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/menuLaporan"
                    android:layout_width="0dp"
                    android:layout_height="130dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    android:orientation="vertical"
                    android:background="@drawable/bg_box_purple"
                    android:padding="16dp"
                    android:gravity="bottom"
                    android:elevation="4dp">
                    <!-- Isian sama -->
                    <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_analytics" app:tint="@android:color/white" android:layout_marginBottom="12dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Laporan" android:textColor="@android:color/white" android:textStyle="bold" android:textSize="16sp"/>
                </LinearLayout>

                <!-- Lakukan hal yang sama untuk menuStok dan menuLaporan -->

            </GridLayout>
        </LinearLayout>
    </ScrollView>

    <!-- FLOATING BUTTON "LAYANI" LEBIH PANJANG -->
    <LinearLayout
        android:id="@+id/btnLayani"
        android:layout_margin="20dp"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/bg_fab_layani"
        android:elevation="10dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_kasir"
            app:tint="@android:color/white"
            android:layout_marginEnd="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mulai Layani Pelanggan"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textSize="16sp"/>
    </LinearLayout>
</FrameLayout>