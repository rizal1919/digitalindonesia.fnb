<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:background="#FFF9C4"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_receipt" app:tint="#F57F17" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/tvTaxName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#424242" android:textStyle="bold" android:text="PPN (0%)" />
        <TextView android:id="@+id/tvTaxDesc" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#F57F17" android:textSize="10sp" android:text="(Termasuk hitung biaya tambahan)" />
    </LinearLayout>
    <TextView android:id="@+id/tvTaxPrice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="12dp" android:textColor="@android:color/black" android:textStyle="bold" android:text="Rp 0" />
    <ImageView android:id="@+id/btnRemoveTax" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_delete" app:tint="#E53935" android:background="?attr/selectableItemBackgroundBorderless" android:clickable="true" android:focusable="true"/>
</LinearLayout>