<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_content_card">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tambah Meja Baru"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#00796B"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/etNewTableName"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_input_outline"
        android:hint="Nama / Nomor Meja (Contoh: VIP 1)"
        android:paddingHorizontal="12dp"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/etNewTableCapacity"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_input_outline"
        android:hint="Kapasitas (Contoh: 4)"
        android:inputType="number"
        android:paddingHorizontal="12dp"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/etNewTableArea"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_input_outline"
        android:hint="Area (Contoh: Indoor, Lantai 2)"
        android:paddingHorizontal="12dp"
        android:layout_marginBottom="24dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSimpanMeja"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Simpan Meja"
        android:textAllCaps="false" />
</LinearLayout>