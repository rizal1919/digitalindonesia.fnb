<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_content_card">

    <LinearLayout android:id="@+id/header" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="20dp" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Pesanan Tersimpan (Hold)" android:textStyle="bold" android:textSize="18sp" android:textColor="@android:color/black"/>
        <ImageView android:id="@+id/btnClose" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_delete" app:tint="#9E9E9E"/>
    </LinearLayout>

    <View android:id="@+id/line" android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" android:layout_below="@id/header"/>

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvHoldOrders" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_below="@id/line" android:layout_above="@id/bottomBar" android:paddingTop="16dp" android:clipToPadding="false"/>

    <LinearLayout android:id="@+id/bottomBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_alignParentBottom="true" android:padding="16dp" android:background="@android:color/white" android:elevation="8dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/btnNewOrder" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="52dp" android:text="Pesanan Baru" android:textColor="#00796B" app:strokeColor="#00796B" app:icon="@drawable/ic_add_2" app:iconGravity="textStart" app:iconTint="#00796B"/>
    </LinearLayout>
</RelativeLayout>