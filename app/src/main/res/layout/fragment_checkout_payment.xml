<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9F9F9">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottomPaymentBar"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ================= SECTION: RINCIAN PEMBAYARAN ================= -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rincian Pembayaran"
                android:textColor="#00796B"
                android:textSize="18sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:background="#E0E0E0" />

            <!-- Diskon Transaksi -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:text="Diskon Transaksi"
                    android:textColor="@android:color/black"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggleDiscTrx"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDiscRp"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="48dp"
                        android:paddingHorizontal="12dp"
                        android:text="Rp"
                        android:textColor="#9E9E9E"
                        app:strokeColor="#E0E0E0" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDiscPercent"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="48dp"
                        android:paddingHorizontal="12dp"
                        android:text="%"
                        android:textColor="@android:color/white"
                        app:backgroundTint="#00796B"
                        app:strokeColor="#00796B" />
                </com.google.android.material.button.MaterialButtonToggleGroup>
            </RelativeLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_input_outline"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <TextView
                    android:id="@+id/tvPrefixDiskon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@android:color/black"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etDiskonTrx"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="0"
                    android:inputType="number"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSuffixDiskon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="%"
                    android:textColor="@android:color/black"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Card Biaya Tambahan & Pajak -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="#E0E0E0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="Biaya Tambahan"
                        android:textColor="@android:color/black"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- Dummy Item Biaya Tambahan -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:background="#F9F9F9"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp"
                        app:cornerRadius="8dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_add"
                            app:tint="#00796B" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="Layanan"
                            android:textColor="#757575" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:text="Rp 2.500"
                            android:textColor="@android:color/black"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_delete"
                            app:tint="#E53935" />
                    </LinearLayout>

                    <!-- Dummy Item Pajak -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:background="#FFF9C4"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp"
                        app:cornerRadius="8dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_receipt"
                            app:tint="#F57F17" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="PPN (10%)"
                                android:textColor="#424242"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="(Termasuk hitung biaya tambahan)"
                                android:textColor="#F57F17"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:text="Rp 250"
                            android:textColor="@android:color/black"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_delete"
                            app:tint="#E53935" />
                    </LinearLayout>

                    <!-- Tombol Add Biaya & Pajak -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAddCharge"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="BIAYA"
                            android:textColor="#00796B"
                            app:icon="@drawable/ic_add"
                            app:iconGravity="textStart"
                            app:iconTint="#00796B"
                            app:strokeColor="#00796B"
                            app:strokeWidth="1dp" /> <!-- Use dash in custom drawable if needed -->

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTaxSetting"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="Pajak"
                            android:textColor="#00796B"
                            app:icon="@drawable/ic_sale"
                            app:iconGravity="textStart"
                            app:iconTint="#00796B"
                            app:strokeColor="#00796B"
                            app:strokeWidth="1dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ================= SECTION: RINGKASAN PEMBAYARAN ================= -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="#E0E0E0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="Ringkasan Pembayaran"
                        android:textColor="#00796B"
                        android:textStyle="bold" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginBottom="12dp" android:background="#EEEEEE" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Subtotal Item" android:textColor="#757575" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rp 27.000" android:textColor="@android:color/black" android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Diskon Item" android:textColor="#757575" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="- Rp 0" android:textColor="#E53935" android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Diskon Transaksi" android:textColor="#757575" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="- Rp 0" android:textColor="#E53935" android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="PPN (10%)" android:textColor="#757575" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rp 250" android:textColor="@android:color/black" android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Biaya Tambahan" android:textColor="#757575" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rp 2.500" android:textColor="@android:color/black" android:textStyle="bold" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginBottom="12dp" android:background="#EEEEEE" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Total Tagihan" android:textColor="@android:color/black" android:textSize="16sp" android:textStyle="bold" />
                        <TextView android:id="@+id/tvSummaryGrandTotal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rp 29.750" android:textColor="#00796B" android:textSize="16sp" android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ================= SECTION: TANGGAL & SPLIT BILL ================= -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:text="Tanggal Transaksi" android:textColor="@android:color/black" android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/btnDatePick"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_input_outline"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_dashboard" app:tint="#9E9E9E" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tanggal Transaksi" android:textColor="#9E9E9E" android:textSize="11sp" />
                    <TextView android:id="@+id/tvTransactionDate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Minggu, 06/09/2026 15:14" android:textColor="@android:color/black" android:textStyle="bold" />
                </LinearLayout>
                <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_down" app:tint="#9E9E9E" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnSplitBill"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_input_outline"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_circle_yellow" android:padding="10dp" android:src="@drawable/ic_money" app:tint="#F57F17" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Split Bill / Bagi Tagihan" android:textColor="@android:color/black" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pisahkan pembayaran per orang atau nominal" android:textColor="#9E9E9E" android:textSize="12sp" />
                </LinearLayout>
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_right" app:tint="#9E9E9E" />
            </LinearLayout>

            <!-- ================= SECTION: METODE PEMBAYARAN ================= -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:text="Jenis Pembayaran" android:textColor="@android:color/black" android:textStyle="bold" />
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/togglePaymentType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:singleSelection="true">
                <com.google.android.material.button.MaterialButton android:id="@+id/btnPayFull" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="Bayar Penuh" android:textColor="@android:color/white" app:backgroundTint="#00796B" app:strokeColor="#00796B" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnPayPartial" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="Sebagian" android:textColor="#757575" app:strokeColor="#E0E0E0" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnPayDebt" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="Hutang" android:textColor="#757575" app:strokeColor="#E0E0E0" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:text="Metode Pembayaran" android:textColor="@android:color/black" android:textStyle="bold" />
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/togglePaymentMethod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:singleSelection="true">
                <com.google.android.material.button.MaterialButton android:id="@+id/btnMethodCash" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="Cash" android:textColor="@android:color/white" app:backgroundTint="#00796B" app:strokeColor="#00796B" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnMethodTransfer" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="Transfer" android:textColor="#757575" app:strokeColor="#E0E0E0" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnMethodQris" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="QRIS" android:textColor="#757575" app:strokeColor="#E0E0E0" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- ================= SECTION: JUMLAH BAYAR ================= -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:text="Jumlah Bayar (Uang Diterima)" android:textColor="@android:color/black" android:textStyle="bold" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_input_outline"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rp " android:textColor="#9E9E9E" android:textSize="18sp" android:textStyle="bold" />
                <EditText android:id="@+id/etAmountReceived" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@null" android:inputType="number" android:textSize="18sp" android:textStyle="bold" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                    <com.google.android.material.chip.Chip android:id="@+id/chipExact" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Uang Pas" android:textColor="#00796B" app:chipBackgroundColor="#E0F2F1" app:chipStrokeColor="#B2DFDB" app:chipStrokeWidth="1dp" />
                    <com.google.android.material.chip.Chip android:id="@+id/chip40k" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Rp 40.000" android:textColor="#424242" app:chipBackgroundColor="@android:color/white" app:chipStrokeColor="#E0E0E0" app:chipStrokeWidth="1dp" />
                    <com.google.android.material.chip.Chip android:id="@+id/chip50k" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Rp 50.000" android:textColor="#424242" app:chipBackgroundColor="@android:color/white" app:chipStrokeColor="#E0E0E0" app:chipStrokeWidth="1dp" />
                    <com.google.android.material.chip.Chip android:id="@+id/chip100k" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Rp 100.000" android:textColor="#424242" app:chipBackgroundColor="@android:color/white" app:chipStrokeColor="#E0E0E0" app:chipStrokeWidth="1dp" />
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom bar: total tagihan + tombol proses -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottomPaymentBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="0dp"
        app:cardElevation="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="TOTAL TAGIHAN" android:textColor="#9E9E9E" android:textStyle="bold" />
                <TextView android:id="@+id/tvBottomTotal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rp 36.000" android:textColor="#00796B" android:textSize="22sp" android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnProsesPembayaran"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Proses Pembayaran"
                android:textAllCaps="false"
                android:textStyle="bold"
                app:backgroundTint="#00796B"
                app:cornerRadius="8dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>