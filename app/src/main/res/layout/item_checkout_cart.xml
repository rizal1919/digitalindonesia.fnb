<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/white"
    android:paddingTop="16dp">

    <!-- 1. Gambar Produk (Modern Rounded Corner) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardImage"
        android:layout_width="64dp"
        android:layout_height="64dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeColor="#EEEEEE"
        app:strokeWidth="1dp">

        <ImageView
            android:id="@+id/ivItemImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#F9F9F9"
            android:scaleType="centerCrop"
            tools:ignore="ContentDescription" />
    </com.google.android.material.card.MaterialCardView>

    <!-- 2. Nama Produk & Tombol Hapus -->
    <TextView
        android:id="@+id/tvItemName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="12dp"
        android:textColor="#00796B"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/btnRemoveItem"
        app:layout_constraintStart_toEndOf="@id/cardImage"
        app:layout_constraintTop_toTopOf="@id/cardImage"
        tools:text="Nasi Goreng Spesial" />

    <ImageView
        android:id="@+id/btnRemoveItem"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="6dp"
        android:src="@drawable/ic_delete"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/cardImage"
        app:tint="#E53935"
        tools:ignore="ContentDescription" />

    <!-- 3. Harga Asli / Varian -->
    <TextView
        android:id="@+id/tvPriceDetail"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#9E9E9E"
        android:textSize="13sp"
        app:layout_constraintEnd_toStartOf="@id/btnRemoveItem"
        app:layout_constraintStart_toStartOf="@id/tvItemName"
        app:layout_constraintTop_toBottomOf="@id/tvItemName"
        tools:text="Rp 25.000 x 1" />

    <!-- 4. Tombol Aksi (Ubah, Diskon, Catatan) - Bisa di-scroll menyamping -->
    <!-- 4. Tombol Aksi (Ubah, Diskon, Catatan) -->
    <HorizontalScrollView
        android:id="@+id/scrollActions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/tvItemName"
        app:layout_constraintTop_toBottomOf="@id/tvPriceDetail">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditPrice"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="12dp"
                android:text="Ubah"
                android:textColor="#00796B"
                android:textSize="12sp"
                app:cornerRadius="8dp"
                app:strokeColor="#B2DFDB"
                app:icon="@drawable/ic_edit_price"
                app:iconPadding="6dp"
                app:iconSize="16dp"
                app:iconTint="#00796B" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDiscount"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="12dp"
                android:text="Diskon"
                android:textColor="#00796B"
                android:textSize="12sp"
                app:cornerRadius="8dp"
                app:strokeColor="#B2DFDB"
                app:icon="@drawable/ic_sale"
                app:iconPadding="6dp"
                app:iconSize="16dp"
                app:iconTint="#00796B" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNote"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="16dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="12dp"
                android:text="Catatan"
                android:textColor="#00796B"
                android:textSize="12sp"
                app:cornerRadius="8dp"
                app:strokeColor="#B2DFDB"
                app:icon="@drawable/ic_edit"
                app:iconPadding="6dp"
                app:iconSize="16dp"
                app:iconTint="#00796B" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- 5. Catatan Text (Muncul jika ada catatan) -->
    <TextView
        android:id="@+id/tvNoteView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_initial_box"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:textColor="#00796B"
        android:textSize="12sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/scrollActions"
        tools:text="Catatan: Pedas Sedang, kuah dipisah" />

    <!-- 6. Kontrol Kuantitas & Harga Final -->
    <LinearLayout
        android:id="@+id/llQtyControl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="@id/tvItemName"
        app:layout_constraintTop_toBottomOf="@id/tvNoteView">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMinus"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="#FFCDD2"
            app:cornerRadius="8dp"
            app:icon="@drawable/ic_minus_2"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="#C62828" />

        <TextView
            android:id="@+id/tvQty"
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@android:color/black"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPlus"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="#00796B"
            app:cornerRadius="8dp"
            app:icon="@drawable/ic_add_2"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="@android:color/white" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvFinalPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#00796B"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/llQtyControl"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/llQtyControl"
        tools:text="Rp 25.000" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="#EEEEEE"
        app:layout_constraintTop_toBottomOf="@id/llQtyControl" />

</androidx.constraintlayout.widget.ConstraintLayout>