<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="12dp">

    <ImageView
        android:id="@+id/ivItemImage"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:scaleType="centerCrop"
        android:background="@drawable/bg_input_outline"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:ignore="ContentDescription" />

    <TextView
        android:id="@+id/tvItemName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:textStyle="bold"
        android:textSize="14sp"
        android:textColor="@android:color/black"
        android:text="Nasi Goreng Spesial"
        app:layout_constraintTop_toTopOf="@id/ivItemImage"
        app:layout_constraintStart_toEndOf="@id/ivItemImage"
        app:layout_constraintEnd_toStartOf="@id/spinnerQty" />

    <TextView
        android:id="@+id/tvItemVariant"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="2dp"
        android:textSize="12sp"
        android:textColor="#9E9E9E"
        android:text="Pedas Sedang"
        app:layout_constraintTop_toBottomOf="@id/tvItemName"
        app:layout_constraintStart_toEndOf="@id/ivItemImage"
        app:layout_constraintEnd_toStartOf="@id/spinnerQty" />

    <TextView
        android:id="@+id/tvItemPrice"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="6dp"
        android:textStyle="bold"
        android:textSize="14sp"
        android:textColor="#FF9800"
        android:text="Rp25.000"
        app:layout_constraintTop_toBottomOf="@id/tvItemVariant"
        app:layout_constraintStart_toEndOf="@id/ivItemImage" />

    <!-- Kontrol Kuantitas: TextView jumlah + ikon dropdown -->
    <LinearLayout
        android:id="@+id/spinnerQty"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_input_outline"
        android:paddingHorizontal="10dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="@id/ivItemImage"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvQty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="01"
            android:textSize="13sp"
            android:textColor="@android:color/black" />

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_banana"
            app:tint="#757575"
            tools:ignore="ContentDescription" />
    </LinearLayout>

    <!-- Baris Edit / Remove -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvItemPrice"
        app:layout_constraintStart_toEndOf="@id/ivItemImage">

        <TextView
            android:id="@+id/tvEditItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✎ Edit"
            android:textSize="12sp"
            android:textColor="#4A55C7"
            android:paddingEnd="16dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tvRemoveItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🗑 Remove"
            android:textSize="12sp"
            android:textColor="#E53935"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
