<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9F9F9"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 1. Header Batal -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_outline"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                app:strokeColor="#00796B"
                app:strokeWidth="1dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="#E0F2F1"
                    android:padding="6dp"
                    android:src="@drawable/ic_money"
                    app:tint="#00796B" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Split Bill / Bagi Tagihan"
                        android:textColor="@android:color/black"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bagi per Item"
                        android:textColor="#00796B"
                        android:textSize="12sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBatalkanSplit"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Batalkan"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    app:backgroundTint="#E53935"
                    app:cornerRadius="8dp" />
            </LinearLayout>

            <!-- 2. Info Split -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#E3F2FD"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_receipt"
                    app:tint="#1976D2" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Split Bill - Per Item"
                        android:textColor="#1565C0"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2 Payer • 2 Item"
                        android:textColor="#546E7A"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_white"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="● 1/2"
                    android:textColor="#388E3C"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 3. Daftar Orang (Horizontal) -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Orang 1 (Tidak aktif) -->
                    <com.google.android.material.chip.Chip
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Orang 1"
                        app:closeIconVisible="true"
                        app:chipBackgroundColor="@android:color/white"
                        app:chipStrokeColor="#E0E0E0"
                        app:chipStrokeWidth="1dp" />

                    <!-- Orang 2 (Aktif) -->
                    <com.google.android.material.chip.Chip
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Orang 2"
                        android:textColor="#00796B"
                        app:chipIcon="@drawable/ic_check_2"
                        app:chipIconTint="#00796B"
                        app:closeIconVisible="true"
                        app:chipBackgroundColor="#E0F2F1"
                        app:chipStrokeColor="#00796B"
                        app:chipStrokeWidth="1dp" />

                    <!-- Tombol Tambah Orang -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="+ Orang"
                        android:textColor="#00796B"
                        android:textStyle="bold" />
                </LinearLayout>
            </HorizontalScrollView>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E0E0E0" android:layout_marginBottom="16dp"/>

            <!-- 4. Target Split Item (Aktif) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#E0F2F1"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_circle_yellow"
                    android:padding="6dp"
                    android:src="@drawable/ic_user"
                    app:tint="#00796B" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Target Split Item:"
                        android:textColor="#757575"
                        android:textSize="12sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Orang 2"
                        android:textColor="@android:color/black"
                        android:textStyle="bold"
                        android:textSize="16sp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="end">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total Sementara"
                        android:textColor="#757575"
                        android:textSize="12sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rp 24,000"
                        android:textColor="#00796B"
                        android:textStyle="bold"
                        android:textSize="16sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- 5. List Menu Makanan (Alokasi Stepper) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_outline"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="nasi goreng"
                        android:textColor="@android:color/black"
                        android:textStyle="bold"
                        android:textSize="16sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="#E8F5E9"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:text="Sisa Item: 0x"
                        android:textColor="#2E7D32"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Stepper -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_minus_2" app:tint="#E53935" />
                    <TextView android:layout_width="32dp" android:layout_height="wrap_content" android:gravity="center" android:text="2" android:textColor="@android:color/black" android:textStyle="bold" android:textSize="16sp" />
                    <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_add_2" app:tint="#BDBDBD" />
                </LinearLayout>
            </LinearLayout>

            <!-- 6. Rincian Pembayaran Per Orang -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rincian Pembayaran Per Orang"
                android:textColor="#263238"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="12dp" />

            <!-- Card Orang 1 (Belum dialokasi) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="#E0E0E0"
                app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                        <ImageView android:id="@+id/icEdit1" android:layout_width="16dp" android:layout_height="16dp" android:layout_centerVertical="true" android:src="@drawable/ic_edit" app:tint="#9E9E9E"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_toEndOf="@id/icEdit1" android:layout_marginStart="8dp" android:layout_centerVertical="true" android:text="Orang 1" android:textColor="@android:color/black" android:textStyle="bold" android:textSize="16sp"/>
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:orientation="vertical" android:gravity="end">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rp 0" android:textColor="#00796B" android:textStyle="bold" android:textSize="16sp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 Item ⓘ" android:textColor="#9E9E9E" android:textSize="10sp"/>
                        </LinearLayout>
                    </RelativeLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" android:layout_marginVertical="12dp"/>
                    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:text="Metode Pembayaran:" android:textColor="#757575"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:background="#F5F5F5" android:paddingHorizontal="12dp" android:paddingVertical="6dp" android:text="Pilih Metode Bayar ⌄" android:textColor="#424242" android:textStyle="bold" android:textSize="12sp"/>
                    </RelativeLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal">
                        <EditText android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_input_outline" android:hint="Rp. 0" android:paddingHorizontal="12dp" android:textStyle="bold"/>
                        <com.google.android.material.button.MaterialButton android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_marginStart="8dp" android:text="Bayar" app:backgroundTint="#00796B" android:insetTop="0dp" android:insetBottom="0dp"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card Orang 2 (Terisi) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="#00796B"
                app:strokeWidth="2dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                        <ImageView android:id="@+id/icEdit2" android:layout_width="16dp" android:layout_height="16dp" android:layout_centerVertical="true" android:src="@drawable/ic_edit" app:tint="#9E9E9E"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_toEndOf="@id/icEdit2" android:layout_marginStart="8dp" android:layout_centerVertical="true" android:text="Orang 2" android:textColor="@android:color/black" android:textStyle="bold" android:textSize="16sp"/>
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:orientation="vertical" android:gravity="end">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rp 24,000" android:textColor="#00796B" android:textStyle="bold" android:textSize="16sp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2 Item ⓘ" android:textColor="#1976D2" android:textSize="10sp"/>
                        </LinearLayout>
                    </RelativeLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" android:layout_marginVertical="12dp"/>
                    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:text="Metode Pembayaran:" android:textColor="#757575"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:background="#F5F5F5" android:paddingHorizontal="12dp" android:paddingVertical="6dp" android:text="Pilih Metode Bayar ⌄" android:textColor="#424242" android:textStyle="bold" android:textSize="12sp"/>
                    </RelativeLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal">
                        <EditText android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_input_outline" android:text="Rp. 24,000" android:textColor="@android:color/black" android:paddingHorizontal="12dp" android:textStyle="bold"/>
                        <com.google.android.material.button.MaterialButton android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_marginStart="8dp" android:text="Bayar" app:backgroundTint="#4CAF50" android:insetTop="0dp" android:insetBottom="0dp"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>