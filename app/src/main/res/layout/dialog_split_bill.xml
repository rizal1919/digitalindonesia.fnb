<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_content_card">

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Pilih Tipe Split Bill" android:gravity="center" android:textSize="18sp" android:textStyle="bold" android:textColor="@android:color/black" />
    <TextView android:id="@+id/tvTotalSplit" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Total Tagihan: Rp 36.000" android:gravity="center" android:textColor="#757575" android:layout_marginBottom="24dp" />

    <!-- Split Per Item -->
    <LinearLayout android:id="@+id/btnSplitBill" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_input_outline" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp" android:layout_marginBottom="12dp">
        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:background="#E3F2FD" android:padding="8dp" android:src="@drawable/ic_receipt" app:tint="#1976D2" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Split Per Item" android:textColor="@android:color/black" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bagi tagihan berdasarkan produk yang dipesan konsumen" android:textColor="#9E9E9E" android:textSize="12sp" />
        </LinearLayout>
        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_right" app:tint="#BDBDBD"/>
    </LinearLayout>

    <!-- Split Per Orang -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_input_outline" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp" android:layout_marginBottom="12dp">
        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:background="#FFF3E0" android:padding="8dp" android:src="@drawable/ic_user" app:tint="#F57F17" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Split Per Orang" android:textColor="@android:color/black" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bagi rata total tagihan secara adil ke beberapa orang" android:textColor="#9E9E9E" android:textSize="12sp" />
        </LinearLayout>
        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_right" app:tint="#BDBDBD"/>
    </LinearLayout>

    <!-- Split Per Nominal -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_input_outline" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp" android:layout_marginBottom="12dp">
        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:background="#FCE4EC" android:padding="8dp" android:src="@drawable/ic_money" app:tint="#C2185B" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Split Per Nominal" android:textColor="@android:color/black" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bagi tagihan jadi beberapa bagian nominal kustom" android:textColor="#9E9E9E" android:textSize="12sp" />
        </LinearLayout>
        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_right" app:tint="#BDBDBD"/>
    </LinearLayout>
</LinearLayout>