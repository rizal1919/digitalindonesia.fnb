<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayoutCheckout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- ========================================================== -->
    <!-- 1. BUNGKUSAN KONTEN UTAMA (WAJIB ADA DI DALAM DRAWERLAYOUT)-->
    <!-- ========================================================== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/white">

        <!-- HEADER -->
        <LinearLayout
            android:id="@+id/headerContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="4dp"
                android:src="@drawable/ic_left"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/tvCheckoutTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:gravity="center"
                android:text="Checkout (1/3)"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@android:color/black" />

            <ImageView
                android:id="@+id/btnMenu"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="4dp"
                android:src="@drawable/ic_menu_hamburger"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- HORIZONTAL DASHED PROGRESS TRACKER -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/progressTracker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="24dp"
            android:paddingTop="8dp"
            android:paddingBottom="16dp"
            android:clipToPadding="false"
            app:layout_constraintTop_toBottomOf="@id/headerContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- STEP 1: Keranjang (Kiri) -->
            <TextView
                android:id="@+id/circleStep1"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/step_circle_active"
                android:gravity="center"
                android:text="1"
                android:textStyle="bold"
                android:textColor="#FF9800"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/circleStep2"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintHorizontal_chainStyle="spread" />

            <TextView
                android:id="@+id/labelStep1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Keranjang"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#FF9800"
                app:layout_constraintTop_toBottomOf="@id/circleStep1"
                app:layout_constraintStart_toStartOf="@id/circleStep1"
                app:layout_constraintEnd_toEndOf="@id/circleStep1" />

            <!-- STEP 2: Pembayaran (Tengah) -->
            <TextView
                android:id="@+id/circleStep2"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/step_circle_inactive"
                android:gravity="center"
                android:text="2"
                android:textStyle="bold"
                android:textColor="#9E9E9E"
                app:layout_constraintStart_toEndOf="@id/circleStep1"
                app:layout_constraintEnd_toStartOf="@id/circleStep3"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/labelStep2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Pembayaran"
                android:textSize="12sp"
                android:textColor="#9E9E9E"
                app:layout_constraintTop_toBottomOf="@id/circleStep2"
                app:layout_constraintStart_toStartOf="@id/circleStep2"
                app:layout_constraintEnd_toEndOf="@id/circleStep2" />

            <!-- STEP 3: Tanda Terima (Kanan) -->
            <TextView
                android:id="@+id/circleStep3"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/step_circle_inactive"
                android:gravity="center"
                android:text="3"
                android:textStyle="bold"
                android:textColor="#9E9E9E"
                app:layout_constraintStart_toEndOf="@id/circleStep2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/labelStep3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Tanda Terima"
                android:textSize="12sp"
                android:textColor="#9E9E9E"
                app:layout_constraintTop_toBottomOf="@id/circleStep3"
                app:layout_constraintStart_toStartOf="@id/circleStep3"
                app:layout_constraintEnd_toEndOf="@id/circleStep3" />

            <!-- Garis putus-putus 1 -->
            <View
                android:id="@+id/lineStep1"
                android:layout_width="0dp"
                android:layout_height="3dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layerType="software"
                android:background="@drawable/line_dashed"
                app:layout_constraintTop_toTopOf="@id/circleStep1"
                app:layout_constraintBottom_toBottomOf="@id/circleStep1"
                app:layout_constraintStart_toEndOf="@id/circleStep1"
                app:layout_constraintEnd_toStartOf="@id/circleStep2" />

            <!-- Garis putus-putus 2 -->
            <View
                android:id="@+id/lineStep2"
                android:layout_width="0dp"
                android:layout_height="3dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layerType="software"
                android:background="@drawable/line_dashed"
                app:layout_constraintTop_toTopOf="@id/circleStep2"
                app:layout_constraintBottom_toBottomOf="@id/circleStep2"
                app:layout_constraintStart_toEndOf="@id/circleStep2"
                app:layout_constraintEnd_toStartOf="@id/circleStep3" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- VIEWPAGER UNTUK MENAMPILKAN KONTEN (KERANJANG, PEMBAYARAN, STRUK) -->
        <!-- Bagian ini yang sebelumnya terhapus -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPagerCheckout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/progressTracker"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ========================================================== -->
    <!-- 2. SIDEBAR CONTAINER (Muncul dari kiri)                    -->
    <!-- ========================================================== -->
    <FrameLayout
        android:id="@+id/sidebarContainer"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:elevation="8dp">

        <!-- Panggil file sidebar yang sama dengan MainActivity -->
        <include layout="@layout/sidebar_content" />

    </FrameLayout>

</androidx.drawerlayout.widget.DrawerLayout>