<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_content_card"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="Tambah Meja Baru"
        android:textColor="@android:color/black"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:text="Nomor / Nama Meja"
        android:textColor="@android:color/black"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etNewTableName"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_input_outline"
        android:hint="Contoh: Meja 01, Meja Bar, dll"
        android:paddingHorizontal="14dp"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- Kolom Kapasitas -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Kapasitas (Orang)"
                android:textColor="@android:color/black"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etNewTableCapacity"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_input_outline"
                android:hint="2"
                android:inputType="number"
                android:paddingHorizontal="14dp"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Kolom Area -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Area Meja"
                android:textColor="@android:color/black"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etNewTableArea"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_input_outline"
                android:hint="Contoh: Indoor, VIP"
                android:paddingHorizontal="14dp"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSimpanMeja"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Simpan Meja"
        android:textAllCaps="false"
        android:textSize="15sp"
        android:textStyle="bold"
        app:backgroundTint="#00796B"
        app:cornerRadius="8dp" />

</LinearLayout>