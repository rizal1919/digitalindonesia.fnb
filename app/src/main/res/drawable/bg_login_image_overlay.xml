<?xml version="1.0" encoding="utf-8"?>
<!--
  Pakai ini KALAU kamu punya gambar background sendiri.
  Cara pakai di layout (ganti ImageView + View jadi 1 FrameLayout):

  <FrameLayout ...>
      <ImageView
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:scaleType="centerCrop"
          android:src="@drawable/bg_login" />

      <View
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:background="@drawable/bg_login_image_overlay" />
  </FrameLayout>

  Overlay ini bikin gambar sedikit digelapkan pakai gradient,
  supaya teks & form login tetap kontras dan gampang dibaca.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="90"
        android:startColor="#66000000"
        android:centerColor="#99000000"
        android:endColor="#CC000000" />
</shape>