<?xml version="1.0" encoding="utf-8"?>
<!-- Simpan di res/drawable/bg_overlay_gradient.xml
     Overlay gelap di atas gambar tema agar teks & ikon tetap kebaca.
     Kalau mau versi paling simpel, ganti pemakaiannya di XML dengan:
     android:background="#B3000000"  (hitam alpha ~70%) -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="90"
        android:startColor="#992D1B4E"
        android:centerColor="#B3210F3D"
        android:endColor="#E60B0620" />
</shape>
