<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Layer 1: Base Gradient Warna Menu -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp"/>
            <gradient
                android:startColor="#FF4B4B"
                android:endColor="#D32F2F"
                android:angle="135"/>
        </shape>
    </item>

    <!-- Layer 2: Ornamen Corak Shape (Lingkaran Transparan di pojok) -->
    <item android:top="-30dp" android:right="-30dp" android:bottom="60dp" android:left="60dp">
        <shape android:shape="oval">
            <solid android:color="#20FFFFFF"/> <!-- Putih dengan 12% Opacity -->
        </shape>
    </item>

    <!-- Layer 3: Ornamen Tambahan di bawah -->
    <item android:top="80dp" android:right="80dp" android:bottom="-20dp" android:left="-20dp">
        <shape android:shape="oval">
            <solid android:color="#10000000"/> <!-- Hitam transparan (Shadow effect) -->
        </shape>
    </item>
</layer-list>