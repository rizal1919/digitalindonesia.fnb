<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Layer 1: Base Gradient (Biru Navy Premium ke Indigo) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" /> <!-- Sudut melengkung halus -->
            <gradient
                android:startColor="#0D47A1"
                android:endColor="#1A237E"
                android:angle="135"
                android:type="linear"/>
        </shape>
    </item>

    <!-- Layer 2: Corak Abstrak 1 (Lingkaran besar di pojok kanan atas) -->
    <item
        android:top="-60dp"
        android:right="-40dp"
        android:bottom="80dp"
        android:left="160dp">
        <shape android:shape="oval">
            <solid android:color="#1AFFFFFF" /> <!-- Putih transparan (Opacity ~10%) -->
        </shape>
    </item>

    <!-- Layer 3: Corak Abstrak 2 (Lingkaran kecil di pojok kiri bawah) -->
    <item
        android:top="100dp"
        android:right="200dp"
        android:bottom="-50dp"
        android:left="-30dp">
        <shape android:shape="oval">
            <solid android:color="#0FFFFFFF" /> <!-- Putih transparan (Opacity ~6%) -->
        </shape>
    </item>

    <!-- Layer 4: Garis Tepi Halus (Memberikan efek Glassmorphism/3D) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <stroke
                android:width="1dp"
                android:color="#33FFFFFF" /> <!-- Garis putih sangat transparan -->
        </shape>
    </item>

</layer-list>